# Development only (npm run dev). Copy this file to .env and fill in YOUR OWN values.
# .env (and .env.local, where JARVIS saves keys you enter in the app) are git-ignored. Never commit real keys.
# The desktop app doesn't use this file: it asks for your key on first launch and stores it
# encrypted by your operating system.

# Required: Google Gemini API key (free at https://aistudio.google.com/apikey). Voice always needs it.
GEMINI_API_KEY=your_api_key_here

# Optional: other providers for chat and agents (choose the provider in API Settings)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Optional: email (use an app password, not your normal password)
# EMAIL_ADDRESS=you@example.com
# EMAIL_APP_PASSWORD=your_app_password_here
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_SMTP_HOST=smtp.example.com

# Optional: NewsAPI key for headlines (otherwise free RSS feeds are used)
# NEWSAPI_KEY=your_newsapi_key_here
